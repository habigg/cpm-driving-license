const playersContainer = document.getElementById("players");
const searchInput = document.getElementById("search");
const playerCount = document.getElementById("playerCount");
const adminButton = document.getElementById("adminButton");
const loginPanel = document.getElementById("loginPanel");
const loginForm = document.getElementById("loginForm");
const loginMessage = document.getElementById("loginMessage");

let players = [];

const statusLabels = {
  passed: "Nokārtots",
  pending: "Gaida eksāmenu",
  failed: "Nenokārtots",
  issued: "Piešķirta",
  not_issued: "Nav piešķirta"
};

function makeBadge(status) {
  const safeStatus = ["passed", "pending", "failed", "issued", "not_issued"]
    .includes(status) ? status : "pending";

  const label = statusLabels[safeStatus] || "Nav norādīts";
  let style = safeStatus;

  if (safeStatus === "issued") style = "passed";
  if (safeStatus === "not_issued") style = "pending";

  const badge = document.createElement("span");
  badge.className = `badge ${style}`;
  badge.textContent = label;
  return badge;
}

function renderPlayers() {
  const query = searchInput.value.trim().toLowerCase();

  const filtered = players.filter(player =>
    String(player.username || "").toLowerCase().includes(query) ||
    String(player.category || "").toLowerCase().includes(query)
  );

  playersContainer.replaceChildren();
  playerCount.textContent = `${filtered.length} spēlētāji`;

  if (filtered.length === 0) {
    const empty = document.createElement("p");
    empty.className = "empty";
    empty.textContent = query
      ? "Spēlētāji nav atrasti."
      : "Spēlētāju saraksts pagaidām ir tukšs.";
    playersContainer.appendChild(empty);
    return;
  }

  filtered.forEach(player => {
    const card = document.createElement("article");
    card.className = "player-card";

    const name = document.createElement("h3");
    name.textContent = player.username || "Nezināms spēlētājs";
    card.appendChild(name);

    const category = document.createElement("div");
    category.className = "player-info";

    const categoryLabel = document.createElement("span");
    categoryLabel.textContent = "Kategorija";

    const categoryValue = document.createElement("strong");
    categoryValue.textContent = player.category || "Nav norādīta";

    category.append(categoryLabel, categoryValue);
    card.appendChild(category);

    const theory = document.createElement("div");
    theory.className = "player-info";
    const theoryLabel = document.createElement("span");
    theoryLabel.textContent = "Teorija";
    theory.append(theoryLabel, makeBadge(player.theory));
    card.appendChild(theory);

    const driving = document.createElement("div");
    driving.className = "player-info";
    const drivingLabel = document.createElement("span");
    drivingLabel.textContent = "Braukšana";
    driving.append(drivingLabel, makeBadge(player.driving));
    card.appendChild(driving);

    const license = document.createElement("div");
    license.className = "player-info";
    const licenseLabel = document.createElement("span");
    licenseLabel.textContent = "Licence";
    license.append(licenseLabel, makeBadge(player.license));
    card.appendChild(license);

    playersContainer.appendChild(card);
  });
}

async function loadPlayers() {
  playersContainer.textContent = "Notiek datu ielāde...";

  try {
    const response = await fetch(`data.json?t=${Date.now()}`, {
      cache: "no-store"
    });

    if (!response.ok) {
      throw new Error("Neizdevās ielādēt data.json");
    }

    const data = await response.json();
    players = Array.isArray(data.players) ? data.players : [];
    renderPlayers();
  } catch (error) {
    console.error(error);
    playersContainer.textContent =
      "Neizdevās ielādēt spēlētāju sarakstu. Pārbaudi, vai data.json ir saglabāts.";
    playerCount.textContent = "Kļūda";
  }
}

searchInput.addEventListener("input", renderPlayers);

adminButton.addEventListener("click", () => {
  loginPanel.classList.toggle("hidden");

  if (!loginPanel.classList.contains("hidden")) {
    loginPanel.scrollIntoView({ behavior: "smooth", block: "center" });
  }
});

loginForm.addEventListener("submit", event => {
  event.preventDefault();

  loginMessage.textContent =
    "Administratora pieslēgšanās vēl nav aktivizēta. Vispirms jāpievieno droša servera puses autentifikācija.";

  loginMessage.setAttribute("role", "status");
});

loadPlayers();