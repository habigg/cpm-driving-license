@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #080b10;
  --panel: #11161e;
  --panel-light: #171e28;
  --border: #252e3a;
  --text: #f2f5f9;
  --muted: #8b97a8;
  --green: #a3ff5f;
  --green-dark: #6acb30;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at top, #17231b 0%, transparent 45%),
    var(--bg);
  color: var(--text);
  font-family: 'Inter', Arial, sans-serif;
}

.navbar {
  height: 76px;
  padding: 0 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border);
  background: rgba(8, 11, 16, 0.9);
}

.logo {
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 1px;
}

.logo span {
  color: var(--green);
}

button {
  border: 0;
  border-radius: 10px;
  padding: 12px 18px;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  background: var(--green);
  color: #10150d;
  transition: 0.2s ease;
}

button:hover {
  background: #bdff91;
  transform: translateY(-1px);
}

.container {
  width: min(1050px, 90%);
  margin: 0 auto;
}

.hero {
  padding: 85px 0 55px;
  text-align: center;
}

.eyebrow {
  margin-bottom: 20px;
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

h1 {
  font-size: clamp(40px, 7vw, 72px);
  font-weight: 800;
  letter-spacing: -3px;
}

h1 span {
  color: var(--green);
}

.subtitle {
  margin: 18px 0 28px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

#search {
  width: min(470px, 100%);
  padding: 16px 18px;
  color: var(--text);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  outline: none;
  font: inherit;
  font-size: 14px;
}

#search:focus,
input:focus {
  border-color: var(--green);
}

.panel {
  margin-bottom: 35px;
  padding: 28px;
  background: rgba(17, 22, 30, 0.92);
  border: 1px solid var(--border);
  border-radius: 18px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 22px;
}

h2 {
  font-size: 18px;
}

#playerCount {
  color: var(--muted);
  font-size: 12px;
}

.players {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 14px;
}

.player-card {
  padding: 20px;
  background: var(--panel-light);
  border: 1px solid var(--border);
  border-radius: 13px;
}

.player-card h3 {
  margin-bottom: 14px;
  overflow-wrap: anywhere;
  font-size: 16px;
}

.player-info {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 11px;
  color: var(--muted);
  font-size: 12px;
}

.badge {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 800;
}

.badge.passed {
  background: #1b3820;
  color: var(--green);
}

.badge.pending {
  background: #3b301a;
  color: #ffd36b;
}

.badge.failed {
  background: #3b2025;
  color: #ff8b98;
}

.empty {
  grid-column: 1 / -1;
  padding: 30px 10px;
  color: var(--muted);
  text-align: center;
  font-size: 14px;
}

.hidden {
  display: none;
}

#loginForm {
  display: grid;
  gap: 12px;
  margin-top: 20px;
}

#loginForm label {
  color: var(--muted);
  font-size: 12px;
}

#loginForm input {
  width: 100%;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 9px;
  outline: none;
  background: var(--bg);
  color: var(--text);
  font: inherit;
}

#loginForm button {
  margin-top: 8px;
}

#loginMessage {
  color: var(--muted);
  font-size: 13px;
}

footer {
  padding: 30px 15px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

