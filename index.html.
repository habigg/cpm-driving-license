<!DOCTYPE html><html lang="lv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080d0b">
  <meta name="description" content="CPM Driving License — Car Parking Multiplayer kopienas spēlētāju eksāmenu rezultāti un licences.">
  <title>CPM Driving License</title>  <link rel="stylesheet" href="./style.css">  <style>
    :root {
      color-scheme: dark;
      --bg: #080d0b;
      --panel: #111a15;
      --green: #55f59a;
      --text: #f3fff7;
      --muted: #94a69a;
      --border: #263a2d;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at top, #183324 0%, transparent 48%),
        var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .navbar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px max(5%, calc((100% - 1100px) / 2));
      background: rgba(8, 13, 11, 0.94);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .logo {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .logo span,
    .hero h1 span {
      color: var(--green);
    }

    .admin-button,
    .primary-button {
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      background: var(--green);
      color: #07130b;
      font-weight: 800;
    }

    .admin-button:hover,
    .primary-button:hover {
      filter: brightness(1.1);
    }

    .container {
      width: min(100% - 32px, 1000px);
      margin: 0 auto;
    }

    .hero {
      padding: 80px 0 54px;
      text-align: center;
    }

    .eyebrow {
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 3px;
    }

    .hero h1 {
      margin: 18px 0;
      font-size: clamp(42px, 8vw, 76px);
      line-height: 1;
      letter-spacing: -2px;
    }

    .subtitle {
      max-width: 580px;
      margin: 0 auto;
      color: var(--muted);
      line-height: 1.7;
    }

    .search-wrap {
      max-width: 540px;
      margin: 30px auto 0;
    }

    .search-input {
      width: 100%;
      padding: 16px 18px;
      color: var(--text);
      background: #101912;
      border: 1px solid var(--border);
      border-radius: 12px;
      outline: none;
    }

    .search-input:focus,
    .form-input:focus {
      border-color: var(--green);
    }

    .panel {
      margin-bottom: 28px;
      padding: 26px;
      background: rgba(17, 26, 21, 0.95);
      border: 1px solid var(--border);
      border-radius: 18px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 24px;
    }

    .section-heading h2,
    .panel h2 {
      margin-top: 0;
    }

    .count {
      color: var(--green);
      font-size: 13px;
      white-space: nowrap;
    }

    .players {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
      gap: 16px;
    }

    .player-card {
      padding: 20px;
      background: #0b120e;
      border: 1px solid var(--border);
      border-radius: 14px;
    }

    .player-card h3 {
      margin: 0 0 18px;
      font-size: 19px;
      overflow-wrap: anywhere;
    }

    .player-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
      color: var(--muted);
      font-size: 14px;
    }

    .badge {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      text-align: center;
    }

    .badge.passed {
      background: #123e27;
      color: #72ffad;
    }

    .badge.pending {
      background: #403617;
      color: #ffe18a;
    }

    .badge.failed {
      background: #421d20;
      color: #ff9ca3;
    }

    .empty {
      grid-column: 1 / -1;
      padding: 30px 10px;
      color: var(--muted);
      text-align: center;
    }

    .hidden {
      display: none !important;
    }

    .login-form {
      display: grid;
      gap: 12px;
    }

    .login-form label {
      color: var(--muted);
      font-size: 14px;
    }

    .form-input {
      width: 100%;
      padding: 13px;
      color: var(--text);
      background: #080d0b;
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
    }

    .message {
      min-height: 20px;
      color: #ffcf8a;
      font-size: 14px;
      line-height: 1.5;
    }

    footer {
      padding: 30px 16px;
      color: var(--muted);
      font-size: 12px;
      text-align: center;
      border-top: 1px solid var(--border);
    }

    @media (max-width: 520px) {
      .navbar {
        padding: 14px 16px;
      }

      .logo {
        font-size: 16px;
      }

      .admin-button {
        padding: 10px 12px;
        font-size: 13px;
      }

      .hero {
        padding-top: 58px;
      }

      .panel {
        padding: 18px;
      }

      .section-heading h2 {
        font-size: 19px;
      }
    }
  </style></head><body>
  <header class="navbar">
    <div class="logo">CPM<span> LICENSE</span></div>
    <button class="admin-button" id="adminButton" type="button">
      Admin Login
    </button>
  </header>  <main class="container">
    <section class="hero">
      <p class="eyebrow">CAR PARKING MULTIPLAYER COMMUNITY</p>  <h1>Driving <span>License</span></h1>

  <p class="subtitle">
    Pārbaudi spēlētāju eksāmenu rezultātus un licences statusu.
    Visi kopienas rezultāti vienuviet.
  </p>

  <div class="search-wrap">
    <input
      class="search-input"
      id="search"
      type="search"
      placeholder="Meklēt spēlētāju..."
      aria-label="Meklēt spēlētāju"
    >
  </div>
</section>

<section class="panel">
  <div class="section-heading">
    <h2>Spēlētāju saraksts</h2>
    <span class="count" id="playerCount">Ielādē...</span>
  </div>

  <div id="players" class="players" aria-live="polite">
    <p class="empty">Notiek datu ielāde...</p>
  </div>
</section>

<section id="loginPanel" class="panel hidden">
  <h2>Administratora pieslēgšanās</h2>

  <p class="subtitle" style="margin: 0 0 22px;">
    Šī sadaļa paredzēta vietnes administratoram.
  </p>

  <form id="loginForm" class="login-form">
    <label for="username">Lietotājvārds</label>
    <input
      class="form-input"
      id="username"
      name="username"
      autocomplete="username"
      required
    >

    <label for="password">Parole</label>
    <input
      class="form-input"
      id="password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
    >

    <button class="primary-button" type="submit">
      Pieteikties
    </button>

    <p id="loginMessage" class="message" role="status"></p>
  </form>
</section>

  </main>  <footer>
    <p>CPM Driving License</p>
    <p>
      Neoficiāls Car Parking Multiplayer kopienas projekts.
      Nav saistīts ar CSDD vai spēles izstrādātājiem.
    </p>
  </footer>  <script>
    (() => {
      "use strict";

      const playersContainer = document.getElementById("players");
      const searchInput = document.getElementById("search");
      const playerCount = document.getElementById("playerCount");
      const adminButton = document.getElementById("adminButton");
      const loginPanel = document.getElementById("loginPanel");
      const loginForm = document.getElementById("loginForm");
      const loginMessage = document.getElementById("loginMessage");

      let players = [];

      const statusLabels = {
        passed: "Nokārtots",
        pending: "Gaida eksāmenu",
        failed: "Nenokārtots",
        issued: "Piešķirta",
        not_issued: "Nav piešķirta"
      };

      function makeBadge(status) {
        const allowed = [
          "passed",
          "pending",
          "failed",
          "issued",
          "not_issued"
        ];

        const safeStatus = allowed.includes(status) ? status : "pending";
        const badge = document.createElement("span");

        badge.className = "badge " +
          (safeStatus === "issued"
            ? "passed"
            : safeStatus === "not_issued"
              ? "pending"
              : safeStatus);

        badge.textContent = statusLabels[safeStatus];
        return badge;
      }

      function addInfo(card, label, value, isBadge = false) {
        const row = document.createElement("div");
        row.className = "player-info";

        const labelElement = document.createElement("span");
        labelElement.textContent = label;
        row.appendChild(labelElement);

        if (isBadge) {
          row.appendChild(makeBadge(value));
        } else {
          const valueElement = document.createElement("strong");
          valueElement.textContent = value || "Nav norādīts";
          row.appendChild(valueElement);
        }

        card.appendChild(row);
      }

      function renderPlayers() {
        const query = searchInput.value.trim().toLowerCase();

        const filtered = players.filter(player =>
          String(player.username || "").toLowerCase().includes(query) ||
          String(player.category || "").toLowerCase().includes(query)
        );

        playersContainer.replaceChildren();
        playerCount.textContent = filtered.length + " spēlētāji";

        if (filtered.length === 0) {
          const empty = document.createElement("p");
          empty.className = "empty";
          empty.textContent = query
            ? "Spēlētāji nav atrasti."
            : "Spēlētāju saraksts pagaidām ir tukšs.";

          playersContainer.appendChild(empty);
          return;
        }

        filtered.forEach(player => {
          const card = document.createElement("article");
          card.className = "player-card";

          const name = document.createElement("h3");
          name.textContent = player.username || "Nezināms spēlētājs";
          card.appendChild(name);

          addInfo(card, "Kategorija", player.category);
          addInfo(card, "Teorija", player.theory, true);
          addInfo(card, "Braukšana", player.driving, true);
          addInfo(card, "Licence", player.license, true);

          playersContainer.appendChild(card);
        });
      }

      async function loadPlayers() {
        playersContainer.replaceChildren();

        const loading = document.createElement("p");
        loading.className = "empty";
        loading.textContent = "Notiek datu ielāde...";
        playersContainer.appendChild(loading);

        try {
          const response = await fetch("./data.json", {
            cache: "no-store"
          });

          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }

          const data = await response.json();

          if (!data || !Array.isArray(data.players)) {
            throw new Error("Nederīgs data.json formāts");
          }

          players = data.players;
          renderPlayers();
        } catch (error) {
          console.error("Datu ielādes kļūda:", error);

          playersContainer.replaceChildren();

          const errorMessage = document.createElement("p");
          errorMessage.className = "empty";
          errorMessage.textContent =
            "Neizdevās ielādēt spēlētāju sarakstu. " +
            "Pārbaudi, vai data.json atrodas tajā pašā mapē.";

          playersContainer.appendChild(errorMessage);
          playerCount.textContent = "Ielādes kļūda";
        }
      }

      searchInput.addEventListener("input", renderPlayers);

      adminButton.addEventListener("click", () => {
        loginPanel.classList.toggle("hidden");

        if (!loginPanel.classList.contains("hidden")) {
          loginPanel.scrollIntoView({
            behavior: "smooth",
            block: "center"
          });
        }
      });

      loginForm.addEventListener("submit", event => {
        event.preventDefault();

        loginMessage.textContent =
          "Administratora pieslēgšanās vēl nav aktivizēta. " +
          "Lai droši pievienotu un rediģētu spēlētājus, " +
          "vispirms jāpievieno servera puses autentifikācija.";

        loginMessage.setAttribute("role", "status");
      });

      loadPlayers();
    })();
  </script></body>
</html>